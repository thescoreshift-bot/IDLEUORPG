{
  // Idle (offline progress) tasks. "Kind" picks the code that runs a task; everything else is data.
  // Harvest tasks read the live harvest tables (ores, veins, skill requirements) of the named system.
  "Tasks": [
    {
      "Id": "mining",
      "Name": "Mining",
      "Kind": "Harvest",
      "HarvestSystem": "Mining",
      "HarvestDefinition": "OreAndStone",
      // Speed multiplier on top of the global offline rate in Configuration/idle.json.
      "Rate": 1.0,
      // Multiplier on the normal skill gain chance, on top of the global one.
      "SkillGainMultiplier": 1.0,
      // One online swing plus re-targeting.
      "SecondsPerAttempt": 2.0,
      // A spot holds 10-34 ore. Each time one runs dry, this many seconds go to walking to the next rock.
      "RelocateSeconds": 60,
      // Average: the world's vein mix (the miner roams between rocks). Target: only the chosen spot's own vein.
      "VeinMode": "Average"
    },
    {
      "Id": "lumberjacking",
      "Name": "Lumberjacking",
      "Kind": "Harvest",
      // No HarvestDefinition: Lumberjacking has a single one. In LBR it yields plain logs (20 per success in Felucca).
      // The hatchet or axe must be equipped, as online.
      "HarvestSystem": "Lumberjacking",
      "Rate": 1.0,
      "SkillGainMultiplier": 1.0,
      // 1-3 chops of 1.6s per harvest (2 on average) plus re-targeting.
      "SecondsPerAttempt": 3.5,
      // A tree area holds 20-45 logs, so it runs dry after one or two successes. Seconds to walk to the next tree.
      "RelocateSeconds": 15,
      "VeinMode": "Average"
    },
    {
      "Id": "fishing",
      "Name": "Fishing",
      "Kind": "Harvest",
      "HarvestSystem": "Fishing",
      "Rate": 1.0,
      "SkillGainMultiplier": 1.0,
      // One cast takes about 8 seconds before the catch, plus re-targeting.
      "SecondsPerAttempt": 9.0,
      // A fishing spot holds 5-15 fish. Seconds to move along the shore to fresh water.
      "RelocateSeconds": 20,
      "VeinMode": "Average",
      // Old footwear from the catch table is thrown back instead of filling the 125-item bank box.
      // Remove names from this list to keep them.
      "DiscardItems": [ "Boots", "Shoes", "Sandals", "ThighBoots" ]
    },
    {
      "Id": "smelting",
      "Name": "Smelting",
      // Takes an order: [Idle smelt <amount>. Uses Mining and needs a forge within 2 tiles, as online.
      // Ore comes from the backpack first, then the bank box; ingots go to the backpack (weight rules) or the bank.
      "Kind": "Smelt",
      "Rate": 1.0,
      "SkillGainMultiplier": 1.0,
      // One double-click on a pile plus targeting the forge.
      "SecondsPerAttempt": 1.5
    },
    {
      "Id": "blacksmithing",
      "Name": "Blacksmithing",
      // Takes an order: [Idle craft <recipe> <amount> [material]. Recipes, skill ranges, costs, and the success and
      // exceptional chances come from the server's live blacksmithing table; [Idle recipes lists them.
      // Needs an anvil and a forge within 2 tiles and a smith's hammer, tongs, or sledgehammer in hand or backpack.
      // Ingots come from the backpack first, then the bank box.
      "Kind": "Craft",
      "CraftSystem": "Blacksmithy",
      "Rate": 1.0,
      "SkillGainMultiplier": 1.0,
      // The craft takes 1.25s online plus choosing the item again in the menu.
      "SecondsPerAttempt": 2.0
    }
  ],

  // Named spots a task can target without a click: [Idle at <Id>, or an external API.
  // The character must stand (or have logged out) within the task's range of Location: 2 tiles for mining, lumberjacking,
  // and smithing, 4 for fishing. "TaskIds" lets one spot serve several tasks.
  "Locations": [
    {
      "Id": "minoc-mine",
      "Name": "Minoc Mine (cave floor by the entrance)",
      "TaskId": "mining",
      "Map": "Felucca",
      "Location": { "x": 2558, "y": 499, "z": 0 }
    },
    {
      "Id": "britain-mine-west",
      "Name": "Britain Mine, west wall (stand at 1438, 1227)",
      "TaskId": "mining",
      "Map": "Felucca",
      "Location": { "x": 1436, "y": 1227, "z": 10 }
    },
    {
      "Id": "britain-woods",
      "Name": "Woods west of Britain, oak tree (stand at 1401, 1527)",
      "TaskId": "lumberjacking",
      "Map": "Felucca",
      "Location": { "x": 1400, "y": 1527, "z": 0 }
    },
    {
      "Id": "yew-woods",
      "Name": "Yew woods south of town, yew tree (stand at 559, 1026)",
      "TaskId": "lumberjacking",
      "Map": "Felucca",
      "Location": { "x": 558, "y": 1026, "z": 0 }
    },
    {
      "Id": "britain-shore",
      "Name": "Britain, open water east of the docks (stand at 1509, 1747)",
      "TaskId": "fishing",
      "Map": "Felucca",
      "Location": { "x": 1508, "y": 1747, "z": -5 }
    },
    {
      "Id": "yew-shore",
      "Name": "Yew, pond shore west of town (stand at 491, 1022)",
      "TaskId": "fishing",
      "Map": "Felucca",
      "Location": { "x": 490, "y": 1022, "z": -5 }
    },
    {
      // Smithies: Location is where to stand, within 2 tiles of both the anvil and the forge (decoration items).
      "Id": "britain-smithy",
      "Name": "Britain, smithy by the docks (anvil 1346,1774, forge 1344,1776)",
      "TaskIds": [ "smelting", "blacksmithing" ],
      "Map": "Felucca",
      "Location": { "x": 1345, "y": 1775, "z": 15 }
    },
    {
      "Id": "britain-smithy-north",
      "Name": "Britain, north smithy (anvil 1423,1556, forge 1424,1558)",
      "TaskIds": [ "smelting", "blacksmithing" ],
      "Map": "Felucca",
      "Location": { "x": 1424, "y": 1557, "z": 30 }
    },
    {
      "Id": "minoc-smithy",
      "Name": "Minoc, smithy beside the mine (anvil 2560,501, forge 2561,501)",
      "TaskIds": [ "smelting", "blacksmithing" ],
      "Map": "Felucca",
      "Location": { "x": 2560, "y": 502, "z": 0 }
    },
    {
      "Id": "minoc-smithy-town",
      "Name": "Minoc, town smithy (anvil 2534,571, forge 2535,571)",
      "TaskIds": [ "smelting", "blacksmithing" ],
      "Map": "Felucca",
      "Location": { "x": 2535, "y": 572, "z": 0 }
    }
  ]
}
